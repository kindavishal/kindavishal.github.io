{
  "name": "kindavishal.github.io",
  "version": "1.0.0",
  "description": "A dynamic, single-page personal portfolio website designed to showcase my experience as a Strategic Program Manager.",
  "main": "index.js",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "dev": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "build": "npm run build:css && html-minifier-terser src/index.html -o index.html --collapse-whitespace --remove-comments --minify-css true --minify-js true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindavishal/kindavishal.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kindavishal/kindavishal.github.io/issues"
  },
  "homepage": "https://github.com/kindavishal/kindavishal.github.io#readme",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.22",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.16"
  }
}